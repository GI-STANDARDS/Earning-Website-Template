{
  "name": "task-referral-platform",
  "version": "1.0.0",
  "description": "A comprehensive task and referral platform with user management, subscriptions, and admin controls",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:utils": "jest backend/tests/utils.test.js",
    "test:auth": "jest backend/tests/auth.test.js",
    "test:tasks": "jest backend/tests/task.test.js",
    "test:system": "jest backend/tests/system.test.js",
    "test:user": "jest backend/tests/user.test.js",
    "test:all": "jest --coverage --testPathPattern=backend/tests",
    "seed": "node backend/scripts/seedDatabase.js",
    "docker:build": "docker build -t task-platform:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f backend"
  },
  "keywords": [
    "task",
    "referral",
    "subscription",
    "payment",
    "admin"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "nodemailer": "^6.9.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
